generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum UserRole {
  CUSTOMER
  ADMIN
  WAREHOUSE_STAFF
  MARKETING
}

enum UserStatus {
  ACTIVE
  INACTIVE
  BANNED
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PACKING
  HANDED_OVER
  SHIPPING
  COMPLETED
  CANCELLED
}

enum PaymentStatus {
  UNPAID
  PAID
  REFUNDED
  FAILED
}

enum DiscountType {
  PERCENTAGE
  FIXED_AMOUNT
}

enum StockMovementType {
  IMPORT
  EXPORT
  ADJUSTMENT
  RETURN
}

enum PaymentProvider {
  COD
  VNPAY
  MOMO
  STRIPE
  BANK_TRANSFER
}

enum TransactionStatus {
  PENDING
  SUCCESS
  FAILED
  REFUNDED
}

enum Gender {
  MALE
  FEMALE
  OTHER
}

model User {
  id              String     @id @default(cuid())
  email           String     @unique
  password        String
  phone           String?    @unique
  fullName        String
  dateOfBirth     DateTime?
  gender          Gender?
  avatarUrl       String?
  avatarPublicId  String?
  role            UserRole   @default(CUSTOMER)
  status          UserStatus @default(ACTIVE)
  emailVerifiedAt DateTime?
  // Đổi SĐT hiện xác thực lại qua OTP gửi tới EMAIL đã xác thực (chưa có hạ tầng SMS —
  // xem AuthService.requestPhoneChange() ở backend-user) — field này set lại mỗi lần đổi
  // SĐT thành công, không phải "SĐT này từng được xác thực bằng SMS".
  phoneVerifiedAt DateTime?
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  addresses          Address[]
  carts              Cart[]
  orders             Order[]
  reviews            Review[]
  refreshTokens      RefreshToken[]
  stockMovements     StockMovement[]
  auditLogs          AuditLog[]
  wishlistItems      WishlistItem[]
  recentlyViewed     RecentlyViewed[]
  orderStatusChanges OrderStatusHistory[]
  voucherRedemptions VoucherRedemption[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String
  expiresAt DateTime
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  receiverName String
  phone        String
  provinceId   String
  districtId   String
  wardId       String
  detail       String
  isDefault    Boolean @default(false)

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  province Province @relation(fields: [provinceId], references: [id])
  district District @relation(fields: [districtId], references: [id])
  ward     Ward     @relation(fields: [wardId], references: [id])

  @@index([userId])
  @@index([provinceId])
  @@index([districtId])
  @@index([wardId])
  @@map("addresses")
}

// Danh mục hành chính Tỉnh/Quận/Phường — đồng bộ (không tự nhập tay) từ API master-data
// của GHN qua LocationsService.syncFromGhn() (src/modules/locations), giữ nguyên ID/code
// gốc của GHN (ghnId là số, ghnCode của Ward là chuỗi — đúng kiểu GHN trả về) để dùng lại
// thẳng khi tạo đơn vận chuyển thật với GHN sau này, không phải tra cứu lại.
model Province {
  id    String @id @default(cuid())
  ghnId Int    @unique
  name  String

  districts District[]
  addresses Address[]

  @@map("provinces")
}

model District {
  id         String @id @default(cuid())
  ghnId      Int    @unique
  provinceId String
  name       String

  province  Province  @relation(fields: [provinceId], references: [id], onDelete: Cascade)
  wards     Ward[]
  addresses Address[]

  @@index([provinceId])
  @@map("districts")
}

model Ward {
  id         String @id @default(cuid())
  ghnCode    String @unique
  districtId String
  name       String

  district  District  @relation(fields: [districtId], references: [id], onDelete: Cascade)
  addresses Address[]

  @@index([districtId])
  @@map("wards")
}

model Category {
  id            String     @id @default(cuid())
  name          String
  slug          String     @unique
  image         String?
  imagePublicId String?
  isActive      Boolean    @default(true)
  isDelete      Boolean    @default(false)
  sortOrder     Int        @default(0)
  parentId      String?
  parent        Category?  @relation("CategoryToCategory", fields: [parentId], references: [id])
  children      Category[] @relation("CategoryToCategory")
  products      Product[]
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt

  @@index([parentId])
  @@map("categories")
}

model Product {
  id                String   @id @default(cuid())
  name              String
  slug              String   @unique
  description       String?
  material          String?
  careInstructions  String?
  brandId           String?
  categoryId        String
  basePrice         Decimal  @db.Decimal(12, 2)
  salePrice         Decimal? @db.Decimal(12, 2)
  status            Int      @default(0)
  thumbnail         String?
  thumbnailPublicId String?
  images            String[] @default([])
  imagePublicIds    String[] @default([])
  metaTitle         String?
  metaDescription   String?
  isDelete          Boolean  @default(false)
  isFeatured        Boolean  @default(false)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  category         Category            @relation(fields: [categoryId], references: [id])
  brand            Brand?              @relation(fields: [brandId], references: [id])
  variants         ProductVariant[]
  reviews          Review[]
  collections      CollectionProduct[]
  wishlistedBy     WishlistItem[]
  recentlyViewedBy RecentlyViewed[]

  @@index([categoryId])
  @@index([brandId])
  @@map("products")
}

model Brand {
  id          String   @id @default(cuid())
  name        String
  logo        String?
  description String?
  origin      String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  products Product[]

  @@map("brands")
}

model Color {
  id        String   @id @default(cuid())
  name      String   @unique
  hexCode   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  variants ProductVariant[]

  @@map("colors")
}

model Collection {
  id             String   @id @default(cuid())
  name           String
  slug           String   @unique
  banner         String?
  bannerPublicId String?
  description    String?
  startDate      DateTime
  endDate        DateTime
  isDelete       Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  products CollectionProduct[]

  @@map("collections")
}

model CollectionProduct {
  id           String   @id @default(cuid())
  collectionId String
  productId    String
  createdAt    DateTime @default(now())

  collection Collection @relation(fields: [collectionId], references: [id], onDelete: Cascade)
  product    Product    @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([collectionId, productId])
  @@index([productId])
  @@index([collectionId])
  @@map("collection_products")
}

model ProductVariant {
  id            String  @id @default(cuid())
  productId     String
  size          String
  color         String
  sku           String  @unique
  price         Decimal @db.Decimal(12, 2)
  stockQuantity Int     @default(0)
  weight        Int? // gram — dùng tính phí ship GHN (backend-user), null = chưa nhập
  imageUrl      String?

  product        Product         @relation(fields: [productId], references: [id], onDelete: Cascade)
  // Tham chiếu theo tên (không phải id) — cột `color` vẫn giữ nguyên là chuỗi tên màu hiển
  // thị, mọi query lọc theo color: { in: [...] } ở products.service.ts (cả backend-cms lẫn
  // backend-user) không cần đổi gì. FK này chỉ thêm ràng buộc "phải là tên đã có trong bảng
  // colors" (chặn free-text tuỳ tiện) + cho join lấy hexCode khi cần. Restrict: không cho
  // xoá 1 màu đang có biến thể nào dùng. Cascade update: đổi tên màu ở bảng colors thì mọi
  // product_variants.color đang trỏ tới tự cập nhật theo, không mồ côi dữ liệu.
  colorRef       Color           @relation(fields: [color], references: [name], onDelete: Restrict, onUpdate: Cascade)
  cartItems      CartItem[]
  orderItems     OrderItem[]
  stockMovements StockMovement[]
  flashSaleItems FlashSaleItem[]

  @@index([productId])
  @@map("product_variants")
}

model Cart {
  id        String   @id @default(cuid())
  userId    String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  items CartItem[]

  @@map("carts")
}

model CartItem {
  id               String @id @default(cuid())
  cartId           String
  productVariantId String
  quantity         Int    @default(1)

  cart           Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id])

  @@index([cartId])
  @@map("cart_items")
}

model WishlistItem {
  id        String   @id @default(cuid())
  userId    String
  productId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@index([userId])
  @@map("wishlist_items")
}

// Lịch sử sản phẩm đã xem — theo tài khoản (userId) khi đã đăng nhập, hoặc theo guestId
// (FE tự sinh UUID lưu cookie/localStorage, gửi qua header X-Guest-Id) khi là khách vãng
// lai, vì backend-user chưa có cơ chế định danh guest ở server nào khác để tái dùng.
model RecentlyViewed {
  id        String   @id @default(cuid())
  userId    String?
  guestId   String?
  productId String
  viewedAt  DateTime @default(now())

  user    User?   @relation(fields: [userId], references: [id], onDelete: Cascade)
  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([userId, productId])
  @@unique([guestId, productId])
  @@index([userId])
  @@index([guestId])
  @@map("recently_viewed")
}

model Order {
  id              String        @id @default(cuid())
  userId          String
  orderCode       String        @unique
  status          OrderStatus   @default(PENDING)
  totalAmount     Decimal       @db.Decimal(12, 2)
  // Số tiền voucher giảm, đã trừ vào totalAmount (totalAmount = subtotal - discountAmount).
  // 0 khi đơn không dùng voucher — giữ non-null để khỏi phải check null ở mọi nơi tính toán.
  discountAmount  Decimal       @default(0) @db.Decimal(12, 2)
  voucherId       String?
  shippingAddress String
  paymentMethod   String
  paymentStatus   PaymentStatus @default(UNPAID)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  user              User                 @relation(fields: [userId], references: [id])
  voucher           Voucher?             @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  items             OrderItem[]
  transactions      PaymentTransaction[]
  statusHistories   OrderStatusHistory[]
  voucherRedemption VoucherRedemption?

  @@index([userId])
  @@index([status])
  @@index([createdAt])
  @@index([voucherId])
  @@map("orders")
}

model OrderItem {
  id               String  @id @default(cuid())
  orderId          String
  productVariantId String
  productName      String
  variantSku       String
  size             String
  color            String
  thumbnail        String?
  quantity         Int
  priceAtPurchase  Decimal @db.Decimal(12, 2)

  order          Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  // Restrict (không phải mặc định) — biến thể đã có trong đơn hàng không được xoá cứng,
  // giống lý do đã áp dụng cho StockMovement.productVariant.
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@map("order_items")
}

// Lịch sử thay đổi trạng thái của 1 đơn hàng — mỗi lần status đổi (kể cả lúc tạo đơn) ghi
// 1 dòng ở đây, dùng để hiển thị timeline đơn hàng cho khách/admin. Tách riêng khỏi
// AuditLog (bảng đó dùng cho hành động CUD chung của admin, không phải timeline nghiệp vụ
// của 1 đơn hàng cụ thể).
model OrderStatusHistory {
  id          String       @id @default(cuid())
  orderId     String
  fromStatus  OrderStatus?
  toStatus    OrderStatus
  note        String?
  changedById String? // null = hệ thống tự ghi (ví dụ lúc tạo đơn), có giá trị nếu admin đổi trạng thái tay
  createdAt   DateTime     @default(now())

  order     Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  changedBy User? @relation(fields: [changedById], references: [id])

  @@index([orderId])
  @@map("order_status_histories")
}

model Voucher {
  id                String       @id @default(cuid())
  code              String       @unique
  // Ảnh minh họa cho voucher (banner quảng bá) — thuần trang trí, không phục vụ logic áp
  // mã. Optional vì voucher tạo nhanh (vd flash sale) không phải lúc nào cũng có ảnh sẵn.
  imageUrl          String?
  imagePublicId     String?
  discountType      DiscountType
  discountValue     Decimal      @db.Decimal(12, 2)
  // Trần số tiền được giảm — chỉ có ý nghĩa khi discountType=PERCENTAGE (giảm theo % không
  // giới hạn có thể vượt quá dự tính trên đơn giá trị lớn). null = không giới hạn trần.
  maxDiscountAmount Decimal?     @db.Decimal(12, 2)
  minOrderValue     Decimal      @default(0) @db.Decimal(12, 2)
  // Bắt buộc chọn — không có khái niệm "hiệu lực ngay lập tức" nữa, admin phải chủ động
  // chọn ngày bắt đầu. expiresAt vẫn optional: null = dùng mãi mãi, không hết hạn.
  startsAt          DateTime
  expiresAt         DateTime?
  // null = không giới hạn tổng lượt / không giới hạn lượt mỗi khách.
  usageLimit        Int?
  usedCount         Int          @default(0)
  perCustomerLimit  Int?
  // Cho phép admin tắt trước hạn mà không cần xóa/sửa expiresAt.
  isActive          Boolean      @default(true)
  createdAt         DateTime     @default(now())
  updatedAt         DateTime     @updatedAt

  orders      Order[]
  redemptions VoucherRedemption[]

  @@map("vouchers")
}

// Ghi lại mỗi lần 1 đơn hàng áp dụng voucher thành công — dùng để đếm lượt/khách (đếm
// redemption theo voucherId+userId, loại đơn CANCELLED) và audit, tương tự cách
// OrderStatusHistory ghi lại lịch sử trạng thái đơn.
model VoucherRedemption {
  id             String   @id @default(cuid())
  voucherId      String
  userId         String
  orderId        String   @unique
  discountAmount Decimal  @db.Decimal(12, 2)
  createdAt      DateTime @default(now())

  voucher Voucher @relation(fields: [voucherId], references: [id], onDelete: Restrict)
  user    User    @relation(fields: [userId], references: [id])
  order   Order   @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([voucherId, userId])
  @@map("voucher_redemptions")
}

model Review {
  id        String   @id @default(cuid())
  productId String
  userId    String
  rating    Int
  comment   String?
  createdAt DateTime @default(now())

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)
  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("reviews")
}

model Banner {
  id            String   @id @default(cuid())
  eyebrow       String?
  title         String
  description   String?
  imageUrl      String
  imagePublicId String?
  linkUrl       String?
  ctaLabel      String?
  ctaLinkUrl    String?
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("banners")
}

// Thanh khuyến mãi trên header, hiển thị mọi trang (khác Banner — carousel chỉ ở trang
// chủ) — chỉ 1 bản active tại 1 thời điểm, giống cách Popup hoạt động. startDate/endDate
// vừa là cửa sổ RUNNING/UPCOMING/ENDED vừa là nguồn format ra khoảng ngày hiển thị
// ("11/08 – 23/08"), không cần field text riêng.
model PromoBar {
  id        String   @id @default(cuid())
  label     String
  highlight String
  linkUrl   String
  isActive  Boolean  @default(true)
  sortOrder Int      @default(0)
  startDate DateTime
  endDate   DateTime
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("promo_bars")
}

model Popup {
  id            String   @id @default(cuid())
  eyebrow       String?
  title         String
  description   String?
  discountCode  String?
  imageUrl      String
  imagePublicId String?
  ctaLabel      String
  ctaLinkUrl    String
  isActive      Boolean  @default(true)
  sortOrder     Int      @default(0)
  startDate     DateTime
  endDate       DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@map("popups")
}

model FlashSale {
  id        String   @id @default(cuid())
  name      String
  startDate DateTime
  endDate   DateTime
  isDelete  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  items FlashSaleItem[]

  @@map("flash_sales")
}

model FlashSaleItem {
  id               String   @id @default(cuid())
  flashSaleId      String
  productVariantId String
  // Giá bán trong đợt sale — số tiền tuyệt đối, phải nhỏ hơn ProductVariant.price hiện tại
  // tại thời điểm thêm vào (validate ở service, không phải ràng buộc DB).
  salePrice        Decimal  @db.Decimal(12, 2)
  // Số lượng tối đa bán với giá sale — phải <= ProductVariant.stockQuantity hiện tại tại
  // thời điểm thêm vào (validate ở service).
  quantityLimit    Int
  // Số đã bán trong đợt sale — CMS tự chỉnh tay ở giai đoạn này, CHƯA nối với luồng tạo đơn
  // thật (backend-user, làm sau — xem docs/superpowers/specs/2026-08-24-flash-sale-design.md
  // mục "Ngoài phạm vi"). isSoldOut suy ra runtime (soldCount >= quantityLimit), không lưu cột.
  soldCount        Int      @default(0)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  flashSale      FlashSale      @relation(fields: [flashSaleId], references: [id], onDelete: Cascade)
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@unique([flashSaleId, productVariantId])
  @@index([flashSaleId])
  @@index([productVariantId])
  @@map("flash_sale_items")
}

model BlogPost {
  id                 String   @id @default(cuid())
  title              String
  slug               String   @unique
  content            String
  coverImage         String?
  coverImagePublicId String?
  isPublished        Boolean  @default(false)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@map("blog_posts")
}

// Nhật ký nhập/xuất/điều chỉnh tồn kho — mỗi thay đổi stockQuantity của 1 variant
// (nhập hàng, bán hàng, kiểm kê, trả hàng) phải ghi 1 dòng ở đây để truy vết được.
model StockMovement {
  id               String            @id @default(cuid())
  productVariantId String
  type             StockMovementType
  quantity         Int // dương = tăng kho, âm = giảm kho
  note             String?
  createdById      String? // null nếu do hệ thống tự trừ kho (ví dụ khi tạo đơn), có giá trị nếu admin thao tác tay
  createdAt        DateTime          @default(now())

  // Restrict (không phải Cascade) — biến thể đã có lịch sử kho không được xoá cứng, tránh
  // mất sổ sách kiểm toán âm thầm khi admin xoá 1 dòng size/màu khỏi sản phẩm (xem
  // products.service.ts syncVariants()).
  productVariant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  createdBy      User?          @relation(fields: [createdById], references: [id])

  @@index([productVariantId])
  @@index([createdById])
  @@map("stock_movements")
}

model SystemConfig {
  key   String @id
  value String

  @@map("system_configs")
}

// Nhật ký hành động của admin (CUD trên product/category/order/cms...) để truy vết
// "ai sửa gì, lúc nào" — không dùng để log lỗi hệ thống (đó là việc của Sentry).
model AuditLog {
  id         String   @id @default(cuid())
  userId     String?
  action     String // ví dụ: "product.create", "category.delete", "order.updateStatus"
  entityType String // ví dụ: "Product", "Category", "Order"
  entityId   String?
  metadata   Json?
  ipAddress  String?
  createdAt  DateTime @default(now())

  user User? @relation(fields: [userId], references: [id])

  @@index([userId])
  @@index([entityType, entityId])
  @@map("audit_logs")
}

// Chi tiết giao dịch thanh toán của 1 đơn hàng — tách riêng khỏi Order.paymentStatus
// vì 1 đơn có thể có nhiều lần thử thanh toán, cần lưu mã giao dịch + raw payload
// từ cổng thanh toán để đối soát.
model PaymentTransaction {
  id            String            @id @default(cuid())
  orderId       String
  provider      PaymentProvider
  amount        Decimal           @db.Decimal(12, 2)
  status        TransactionStatus @default(PENDING)
  providerTxnId String? // mã giao dịch từ cổng thanh toán (VNPay/Momo/Stripe)
  rawPayload    Json? // raw webhook payload, dùng khi cần đối soát
  createdAt     DateTime          @default(now())
  updatedAt     DateTime          @updatedAt

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payment_transactions")
}
